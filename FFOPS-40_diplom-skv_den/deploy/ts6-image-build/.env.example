# ==========================================
# СЕКРЕТНЫЕ КЛЮЧИ (сгенерируйте: bash scripts/gen_secrets.sh)
# ==========================================
# Случайная строка минимум 32 символа (openssl rand -hex 32)
JWT_SECRET=замените_на_очень_длинную_случайную_строку_минимум_32_символа
# Другая длинная случайная строка для шифрования учётных данных менеджера
ENCRYPTION_KEY=замените_на_другую_длинную_случайную_строку_минимум_32_символа

# Пароль администратора ServerQuery (SSH/WebQuery) TeamSpeak 6
TS6_QUERY_ADMIN_PASSWORD=придумайте_надёжный_пароль_для_serveradmin

# ==========================================
# ПУТИ К ДАННЫМ (локально, только для docker compose на хосте)
# ==========================================
# Путь к данным TeamSpeak 6 сервера
TS6_DATA_PATH=/volume1/teamspeak/ts6

# Путь к данным backend (база данных менеджера)
BACKEND_DATA_PATH=/volume1/docker/ts6_project/backend/backend-data

# Путь к музыке для стриминга
MUSIC_DATA_PATH=/volume1/docker/ts6_project/backend/music-data

# ==========================================
# НАСТРОЙКИ ВЕБ-ИНТЕРФЕЙСА
# ==========================================
# URL, по которому доступен web-интерфейс (используется backend для CORS)
# В кластере k8s: http://<NLB_IP> (подставляется при деплое/сборке)
FRONTEND_URL=http://localhost:3000

# Порт для web-интерфейса (только для docker compose)
FRONTEND_PORT=3000

# URL sidecar внутри кластера (Service sidecar:9800)
SIDECAR_URL=http://sidecar:9800

# TeamSpeak 6 по умолчанию использует самоподписанные сертификаты WebQuery
TS_ALLOW_SELF_SIGNED=true