[masters]

%{~ for i in masters ~}
${i.name} ansible_host=${i.ip}

%{~ endfor ~}

[workers]

%{~ for i in workers ~}
${i.name} ansible_host=${i.ip}

%{~ endfor ~}

[workers:vars]
# SSH использовать с ProxyJump в файле ~/.ssh/config_yc_k8s
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${ssh_key_file}

[all:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${ssh_key_file}